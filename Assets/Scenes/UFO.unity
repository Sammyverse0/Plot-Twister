--- !u!114 &820097139
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 820097119}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 70e6277ac2a79704abc7d334b29d4041, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  tutorialPanel: {fileID: 0}
  dialogueBox: {fileID: 1459384642}
  portraitImage: {fileID: 328567250}
  nameText: {fileID: 297165461}
  bodyText: {fileID: 1572601388}
  charsPerSecond: 35
  holdTime: 2
  startDelay: 0.5
  audioSource: {fileID: 0}
  typeSound: {fileID: 0}
  soundEveryNChars: 2
  pitchRange: {x: 0.9, y: 1.1}
  sequences:
  - id: Intro
    lines:
    - speakerName: Farmer
      portrait: {fileID: 0}
      text: I wonder why the crops are dry... I should check the generator.
    - speakerName: Farmer
      portrait: {fileID: 0}
      text: Better twist the plots to get the water flowing.
  - id: AlienRise
    lines:
    - speakerName: Farmer
      portrait: {fileID: 0}
      text: What the heck?! ALIENS IN MY PLOTS?!
  - id: Finale
    lines:
    - speakerName: Alien
      portrait: {fileID: 21300000, guid: 0693c72a4d3403843ad5a6eb8c6d8117, type: 3}
      text: I can't believe I was one of you this whole time...
    - speakerName: Bob
      portrait: {fileID: 21300000, guid: ecf23e689db4a554dad4e68751f8ddf3, type: 3}
      text: Yes. You always were. You were an experiment. The time has come, join
        us and let's take over humanity.
    - speakerName: Alien
      portrait: {fileID: 21300000, guid: 0693c72a4d3403843ad5a6eb8c6d8117, type: 3}
      text: I could never join you. I believe in humanity.
    - speakerName: Alien
      portrait: {fileID: 21300000, guid: 0693c72a4d3403843ad5a6eb8c6d8117, type: 3}
      text: They deserve to live. We can't take over humanity.
    - speakerName: Bob
      portrait: {fileID: 21300000, guid: ecf23e689db4a554dad4e68751f8ddf3, type: 3}
      text: Fine, your wish. Might as well end you with humanity.
